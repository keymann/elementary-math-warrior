{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elementary-math-warrior",
  "compatibility_date": "2026-08-06",

  // 배포 전에 여기서 직접 빌드한다.
  // Cloudflare Workers Builds 는 Deploy command(`npx wrangler deploy`)만 실행하고
  // 빌드 단계를 따로 돌리지 않는 설정일 수 있다. 그 경우 dist/ 가 없어 배포가 실패한다.
  // 빌드를 wrangler 설정에 넣어두면 대시보드 설정과 무관하게 항상 산출물이 만들어진다.
  "build": {
    "command": "npm run build"
  },

  // 정적 자산만 배포한다(Worker 스크립트 없음).
  // `main` 을 두지 않으면 assets-only Worker 로 배포된다.
  "assets": {
    "directory": "./dist",

    // 이 앱은 index.html(게임) + poc.html(어댑터 검수) 로 된 **멀티페이지**다.
    // wrangler 기본 제안값인 "single-page-application" 을 쓰면 존재하지 않는 경로가
    // 전부 index.html 로 덮여 404 가 가려진다. 실제 파일이 있는 경로만 서빙한다.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
