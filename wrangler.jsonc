{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elementary-math-warrior",
  "compatibility_date": "2026-08-06",

  // 정적 자산만 배포한다(Worker 스크립트 없음).
  // `main` 을 두지 않으면 assets-only Worker 로 배포된다.
  "assets": {
    "directory": "./dist",

    // 이 앱은 index.html(게임) + poc.html(어댑터 검수) 로 된 **멀티페이지**다.
    // wrangler 기본 제안값인 "single-page-application" 을 쓰면 존재하지 않는 경로가
    // 전부 index.html 로 덮여 404 가 가려진다. 실제 파일이 있는 경로만 서빙한다.
    "not_found_handling": "404-page"
  },

  "observability": {
    "enabled": true
  }
}
